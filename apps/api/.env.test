DATABASE_URL="postgresql://jobtracker:jobtracker@localhost:5434/jobtracker_test?schema=public"
NODE_ENV=test
PORT=3002
LOG_LEVEL=silent
JWT_SECRET="test-secret-that-is-definitely-long-enough-32"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:3000
# Test suites make many requests through one in-memory address. Production limits are
# exercised by configuration and should not couple otherwise independent tests.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=1000
