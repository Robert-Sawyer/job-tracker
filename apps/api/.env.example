DATABASE_URL="postgresql://jobtracker:jobtracker@localhost:5433/jobtracker?schema=public"
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Global API limit: 100 requests per minute per IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Register and login share this stricter limit.
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Set in production to a Redis URL when API runs with more than one replica.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Railway/Upstash-style connection strings are also supported.
# REDIS_URL=redis://default:password@host:6379
