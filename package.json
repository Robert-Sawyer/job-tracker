{
  "name": "job-tracker",
  "version": "1.0.0",
  "description": "A full-stack job application tracker built with Next.js, Fastify, Prisma, PostgreSQL, and Redis.",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "keywords": [
    "job-tracker",
    "nextjs",
    "fastify",
    "prisma",
    "postgresql",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.17.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.x",
    "@types/node": "^22.x",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.x",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
